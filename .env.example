APP_NAME="BCJ - Billard club de Joué-Lès-Tours"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ADMIN_HTTPS=false

# URL du frontend React (dev). Utilisee pour le CORS (autorise les requetes du
# front) et pour construire des liens vers le site public.
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bcj37
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Connexion des imports declenches depuis l'admin (licences Telemat, CueScore).
# "database" = traitement en arriere-plan : NECESSITE un worker `php artisan queue:work`.
# Mettre "sync" pour une execution inline (bloquante) sans worker.
ADMIN_IMPORT_QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contact@bcj37.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Formulaire de contact : destinataire et expediteur (defaut = production).
# Sur un environnement de test, rediriger vers une boite perso, ex :
# CONTACT_TO_ADDRESS=adresse@exemple.fr
CONTACT_TO_ADDRESS="contact@bcj37.fr"
CONTACT_FROM_ADDRESS="no-reply@bcj37.fr"
CONTACT_FROM_NAME="BCJ37 — Formulaire de contact"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Cle de licence CKEditor 5 (a renseigner localement, ne jamais commiter).
CKE5_LICENSE_KEY=

# Integration Facebook (a renseigner localement, ne jamais commiter).
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

MATOMO_URL=
MATOMO_SITE_ID=
MATOMO_ENABLE=false

LICENSE_IMPORT_BASE_URL=https://www.telemat.org
LICENSE_IMPORT_ENDPOINT=/FFBI/sif/
LICENSE_IMPORT_USERNAME=
LICENSE_IMPORT_PASSWORD=
LICENSE_IMPORT_TABLE_SELECTOR=
LICENSE_IMPORT_METHOD=GET

LICENSE_IMPORT_NUM=
LICENSE_IMPORT_NOM=
LICENSE_IMPORT_PRENOM=
LICENSE_IMPORT_CLUB=
LICENSE_IMPORT_CS=
LICENSE_IMPORT_FIND=auto
LICENSE_IMPORT_DRY_RUN=true
LICENSE_IMPORT_USER_AGENT="ClubApp License Import Bot/1.0"

LICENSE_IMPORT_HTTP_TIMEOUT=30
LICENSE_IMPORT_HTTP_CONNECT_TIMEOUT=10
LICENSE_IMPORT_HTTP_RETRIES=2
LICENSE_IMPORT_HTTP_RETRY_SLEEP_MS=1000

LICENSE_IMPORT_LOCK_NAME=license-import:ffbi-telemat
LICENSE_IMPORT_LOCK_TTL_SECONDS=900

LICENSE_IMPORT_QUEUE=default
LICENSE_IMPORT_JOB_TIMEOUT_SECONDS=1200

LICENSE_IMPORT_MIN_RAW_ROWS=10
LICENSE_IMPORT_MIN_VALID_RATIO_PERCENT=80
LICENSE_IMPORT_MAX_INVALID_RATIO_PERCENT=20

LICENSE_IMPORT_MIN_LICENSE_NUMBER_FILL_RATE=95
LICENSE_IMPORT_MIN_LAST_NAME_FILL_RATE=95
LICENSE_IMPORT_MIN_FIRST_NAME_FILL_RATE=95

LICENSE_IMPORT_TOTAL_ROWS_VARIATION_WARNING=15
LICENSE_IMPORT_TOTAL_ROWS_VARIATION_REJECT=35
LICENSE_IMPORT_VALID_ROWS_VARIATION_WARNING=15
LICENSE_IMPORT_VALID_ROWS_VARIATION_REJECT=35
LICENSE_IMPORT_FIELD_FILL_RATE_WARNING=10
LICENSE_IMPORT_FIELD_FILL_RATE_REJECT=25
LICENSE_IMPORT_INVALID_RATIO_WARNING=10
LICENSE_IMPORT_INVALID_RATIO_REJECT=25

LICENSE_IMPORT_DRY_RUN=false
LICENSE_IMPORT_KEEP_LAST_ACTIVATED_BATCHES=10
LICENSE_IMPORT_KEEP_LAST_REJECTED_BATCHES=10
LICENSE_IMPORT_KEEP_LAST_FAILED_BATCHES=10
LICENSE_IMPORT_RETENTION_MAX_AGE_DAYS=365
