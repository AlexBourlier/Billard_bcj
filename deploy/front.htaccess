# .htaccess du frontend React (SPA) — a placer a la racine servie par
# test.alexandrebourlier.fr (le contenu de frontend/dist/).
#
# Role : renvoyer toutes les routes inconnues vers index.html afin que le
# routage cote client (React Router) fonctionne au rafraichissement / acces
# direct a une URL profonde (ex. /disciplines/blackball).

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Fichiers et dossiers reels servis tels quels (assets, images, etc.).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste -> index.html (application SPA).
    RewriteRule ^ index.html [L]
</IfModule>

# Forcer HTTPS (le site est servi en https).
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Cache long pour les assets versionnes (hash dans le nom de fichier).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>

# index.html ne doit pas etre mis en cache agressivement (nouvelle version a chaque deploi).
<IfModule mod_headers.c>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
